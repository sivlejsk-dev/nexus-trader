# ── Nexus AI (OpenAI-compatible) ─────────────────────────────────────────────
# Primary LLM — OpenAI GPT-4o or any OpenAI-compatible endpoint
NEXUS_API_KEY=sk-...
NEXUS_API_BASE_URL=https://api.openai.com/v1
NEXUS_MODEL=gpt-4o

# Fast inference fallback — Groq (free tier available at console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── Market Data ───────────────────────────────────────────────────────────────
# Polygon.io — real-time quotes, historical OHLCV, options chains
# Free tier: delayed data. Paid tiers: real-time + options.
# Sign up: https://polygon.io
POLYGON_API_KEY=

# Alpha Vantage — historical OHLCV + technical indicators (free tier: 25 req/day)
# Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Tradier — options chains (free sandbox available)
# Sign up: https://developer.tradier.com
TRADIER_API_KEY=
TRADIER_BASE_URL=https://sandbox.tradier.com/v1

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# ── Auth (change in production) ───────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-change-in-production
