# ── Nexus AI (OpenAI-compatible LLM) ─────────────────────────────────────────
# Required for full AI chat. Supports OpenAI, Groq, or any OpenAI-compatible API.
NEXUS_API_KEY=
NEXUS_API_BASE_URL=https://api.openai.com/v1
NEXUS_MODEL=gpt-4o

# Groq — fast inference fallback (free tier available at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Web Research (Nexus internet access) ─────────────────────────────────────
# DuckDuckGo is used automatically — no key needed.
# Add these for higher-quality Google/Brave results:

# Serper.dev — Google search results (~2500 free queries/month)
# https://serper.dev
SERPER_API_KEY=

# Brave Search API — independent index, no Google dependency
# https://api.search.brave.com
BRAVE_API_KEY=

# ── Market Data ───────────────────────────────────────────────────────────────
# Polygon.io — real-time + historical (free tier available)
# https://polygon.io
POLYGON_API_KEY=

# Alpha Vantage — free historical OHLCV fallback (25 req/day free)
# https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=

# Tradier — options chains (free sandbox available)
# https://developer.tradier.com
TRADIER_API_KEY=

# ── News & Sentiment ──────────────────────────────────────────────────────────
NEWS_API_KEY=
TWITTER_BEARER_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
JWT_SECRET_KEY=change-me-in-production
